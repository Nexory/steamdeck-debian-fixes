# Copy to ~/voice/voice.env and edit. hey.sh sources this file before
# starting hey.py. Keep any real tokens in voice.env only, and keep that file
# out of version control.
#
# Adjust the paths to your username if it is not "deck".

# --- audio devices -----------------------------------------------------------
# Find the card and device numbers with "arecord -l" and "aplay -l".
MIC_DEV=plughw:1,0
SPK_DEV=plughw:1,1

# Ceiling for the soft normalizer that lifts quiet, distant speech.
MIC_GAIN=20

# --- wake word ---------------------------------------------------------------
WAKE_MODEL=hey_jarvis_v0.1
# Lower means it triggers more easily and also more often by accident.
WAKE_THRESH=0.5

# --- voice activity detection ------------------------------------------------
VAD_ON=0.5
VAD_OFF=0.35
# Silence in ms that ends an utterance. Raise it if you get cut off mid
# sentence, lower it if the assistant feels sluggish to respond.
END_MS=650
ONSET_MS=3000
# Window in ms for follow up questions without repeating the wake word.
FOLLOWUP_MS=6000

# --- speech to text and text to speech ---------------------------------------
# IMPORTANT: these belong to voiced.py, which systemd starts on its own. It
# never sees this file. Putting them here documents the intent but changes
# nothing. To actually change them, edit the drop-in and restart the service:
#
#   ~/.config/systemd/user/voiced.service.d/model.conf
#   systemctl --user daemon-reload && systemctl --user restart voiced
#
#WHISPER_MODEL=cstr/whisper-large-v3-turbo-german-int8_float32
#WHISPER_LANG=de
#WHISPER_THREADS=8
#PIPER_VOICE=/home/deck/voice/de_DE-thorsten-high.onnx
# Higher is slower and clearer. Must be passed as a SynthesisConfig, which
# voiced.py does. Editing the .onnx.json sidecar has no effect.
#PIPER_LENGTH_SCALE=1.10

# --- language backend --------------------------------------------------------
# Any CLI that reads a prompt on stdin and prints a plain text reply on
# stdout. A locally hosted model runner and an API backed CLI both fit.
# Leave empty to test the audio path without any backend at all.
#
# Quote it. This file is sourced by bash, so an unquoted value with flags
# would be read as a command with a variable assignment in front of it.
#
#   LLM_CMD="my-llm-cli --quiet"
#
LLM_CMD=""
# Set to 1 only if LLM_CMD needs a real shell for pipes or redirection.
LLM_SHELL=0
LLM_TIMEOUT=120

PERSONA_FILE=~/voice/assistant.md
# Number of previous exchanges kept so follow up questions make sense.
HISTORY_TURNS=6

# --- optional ----------------------------------------------------------------
# Only needed if the automatic lookup inside the openwakeword package fails.
#SILERO_VAD_PATH=/home/deck/voice/venv/lib/python3.11/site-packages/openwakeword/resources/models/silero_vad.onnx

# Touched whenever the assistant wakes up. Another daemon can watch this file,
# for example to switch a display backlight on.
WAKE_FLAG=~/voice/.wake

# If your backend needs a token, read it from this file rather than hardcoding
# it anywhere, and reference it from LLM_CMD:
#MY_BACKEND_TOKEN=<REPLACE_WITH_YOUR_TOKEN>
